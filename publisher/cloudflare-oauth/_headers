/*
  Content-Security-Policy: default-src 'self'; img-src 'self'; script-src 'self'; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

/cloudflare-oauth-callback.html
  Cache-Control: no-store

/cloudflare-oauth-callback.js
  Cache-Control: no-store
