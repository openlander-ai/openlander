{
  "git": {
    "commitMessage": "chore: release v${version}",
    "tagName": "v${version}",
    "requireCleanWorkingDir": true
  },
  "npm": {
    "publish": false
  },
  "github": {
    "release": false
  },
  "hooks": {
    "before:init": "npm run qa:release && npm run test:coverage && npm pack --dry-run --json --ignore-scripts",
    "after:bump": "node scripts/sync-release-version.mjs ${version}"
  },
  "plugins": {
    "@release-it/keep-a-changelog": {
      "filename": "CHANGELOG.md",
      "strictLatest": false
    }
  }
}
