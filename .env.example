# ============================================
# OpenLander Environment Variables
# ============================================
# Copy this file to .env and adjust values.
# Most settings are also configurable via ~/.openlander/config.json
# docker-compose.runtime.yml has safe local defaults. Direct/custom
# runtimes can provide OPENLANDER_DATABASE_URL or DATABASE_URL.

# --- Server ---
# LOG_LEVEL=info
#   Log verbosity: silent, fatal, error, warn, info, debug, trace
#   Default: info

# NODE_ENV=production
#   Node.js environment: production, development, test
#   Default: production (in logger, test mode silences logs)

# --- Security ---
# OPENLANDER_MASTER_KEY=
#   AES-256 hex key for encrypting API tokens and secrets
#   Must be 64 hex characters (256 bits) if provided
#   Auto-generated and stored at ~/.openlander/master.key if empty
#   Example: 0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# OPENLANDER_SESSION_TTL_HOURS=168
#   Web session duration in hours
#   Default: 168 (7 days)

# --- Docker ---
# DOCKER_HOST=
#   Docker daemon socket or URL
#   Examples:
#     unix:///var/run/docker.sock (Linux default)
#     unix:///Users/user/.docker/run/docker.sock (macOS Docker Desktop)
#     tcp://localhost:2375 (remote daemon)
#   Auto-detected if empty

# --- Network ---
# HOST_IP=
#   Server LAN IP for Traefik routing
#   Used for internal access (same network)
#   Auto-detected if empty
#   Example: 192.168.1.100

# HOST_VPN_IP=
#   VPN/Tailscale IP override for project URLs
#   Used when accessing via VPN tunnel
#   Optional, only set if using VPN/Tailscale
#   Example: 100.64.0.1

# OPENLANDER_PROTECTED_SHARE_TLS_MODE=managed
#   Use "external" when Caddy, Nginx, or another host proxy already owns
#   port 443. The external proxy must terminate TLS and forward active share
#   hostnames to OpenLander's Traefik HTTP entrypoint on port 80.

# --- Database ---
# OPENLANDER_POSTGRES_PASSWORD=openlander
#   Password for the bundled Postgres sidecar in docker-compose.runtime.yml.
#   Default: openlander. The database is not exposed outside the compose
#   network by default; override this if you expose/share the DB service.
#
# OPENLANDER_DATABASE_URL=
#   Postgres connection URL for direct/custom runtimes.
#   Example: postgres://openlander:change-me@localhost:5432/openlander
#
# DATABASE_URL=
#   Compatibility alias for OPENLANDER_DATABASE_URL.

# --- GitHub OAuth (Optional) ---
# OPENLANDER_GITHUB_CLIENT_ID=
#   GitHub OAuth app client ID for device flow authentication
#   If not set, uses built-in default (limited rate limits)
#   Get from: https://github.com/settings/developers
#   Only needed if you want higher GitHub API rate limits

# --- Cloudflare Connected Publish (Self-build publisher overrides) ---
# OPENLANDER_CLOUDFLARE_OAUTH_CLIENT_ID=
#   Official releases include OpenLander's public PKCE client. Set this only
#   when a self-built distribution uses its own Cloudflare OAuth client.
#
# OPENLANDER_CLOUDFLARE_OAUTH_REDIRECT_URI=
#   Fixed HTTPS callback registered on the custom OAuth client. It must host the
#   callback assets and only bridge code/state back to the OpenLander opener.
#
# OPENLANDER_CLOUDFLARE_OAUTH_SCOPES=
#   Comma-separated scope IDs registered for the custom client. They must cover
#   account/Zone reads, DNS writes, and Cloudflare Tunnel/connector writes.

# --- Telegram Bot (Optional) ---
# TELEGRAM_WEBHOOK_URL=
#   Telegram webhook URL for bot notifications
#   Format: https://your-domain.com/webhook/telegram
#   Only set if Telegram bot is enabled in config

# --- Testing ---
# OPENLANDER_API_TOKEN=
#   API token for E2E tests (auto-generated during test setup)
#   Not needed for normal operation

# OPENLANDER_SESSION=
#   Session cookie for E2E tests (auto-generated during test setup)
#   Not needed for normal operation

# OPENLANDER_SG_REEXEC=
#   Internal flag for macOS security group re-execution
#   Not needed for normal operation
