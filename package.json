{
  "name": "openlander",
  "version": "0.1.0",
  "description": "Self-hosted deployment platform that fixes its own failures",
  "type": "module",
  "bin": {
    "openlander": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "web/dist",
    "drizzle",
    "Dockerfile",
    "Dockerfile.runtime",
    ".dockerignore",
    "Dockerfile.runtime.dockerignore",
    "docker-compose.yml",
    "docker-compose.runtime.yml",
    "install.sh",
    "scripts/build-runtime-image.sh",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "npm run clean && tsup && npm run build:web",
    "build:web": "cd web && npm ci && npx vite build",
    "docker:build:runtime": "bash scripts/build-runtime-image.sh",
    "docker:up:runtime": "bash scripts/build-runtime-image.sh && OPENLANDER_IMAGE=${OPENLANDER_IMAGE:-openlander:local} docker compose -f docker-compose.runtime.yml up -d",
    "start": "node dist/cli/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:backend:release",
    "test:backend:release": "vitest run --config vitest.release.config.ts",
    "test:migrations": "vitest run --config vitest.release.config.ts test/db/postgres-migration-sanity.test.ts test/db/schema-parity.test.ts",
    "test:api-contract": "vitest run --config vitest.release.config.ts test/contract/system-routes-services.test.ts test/console-contract.test.ts",
    "test:watch": "vitest --config vitest.release.config.ts --watch",
    "test:coverage": "vitest run --config vitest.release.config.ts --coverage",
    "qa:release": "npm run lint -- --quiet && npm run typecheck && npm run test:backend:release && npm run build",
    "clean": "rm -rf dist",
    "release": "release-it",
    "release:rc": "release-it --preRelease=rc",
    "release:final": "release-it",
    "prepublishOnly": "npm run build",
    "prepare": "husky",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "docs:validate": "npx tsx scripts/validate-doc-claims.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.71",
    "@ai-sdk/deepseek": "^2.0.29",
    "@ai-sdk/google": "^3.0.64",
    "@ai-sdk/groq": "^3.0.35",
    "@ai-sdk/mcp": "^1.0.36",
    "@ai-sdk/mistral": "^3.0.30",
    "@ai-sdk/openai": "^3.0.53",
    "@ai-sdk/togetherai": "^2.0.45",
    "@ai-sdk/xai": "^3.0.83",
    "@hono/node-server": "^1.19.11",
    "@hono/node-ws": "^1.3.0",
    "@inquirer/prompts": "^8.4.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openrouter/ai-sdk-provider": "^2.8.1",
    "ai": "^6.0.168",
    "bcryptjs": "^3.0.3",
    "commander": "^14.0.3",
    "dockerode": "^4.0.12",
    "drizzle-orm": "^0.45.1",
    "duck-duck-scrape": "^2.2.7",
    "hono": "^4.12.15",
    "nanoid": "^5.1.9",
    "nodemailer": "^8.0.7",
    "ollama-ai-provider-v2": "^3.5.0",
    "picocolors": "^1.1.1",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "sugar-high": "^0.9.5",
    "ws": "^8.20.0",
    "yaml": "^2.8.2",
    "zhipu-ai-provider": "^0.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@playwright/test": "^1.59.1",
    "@release-it/keep-a-changelog": "^7.0.1",
    "@types/dockerode": "^4.0.1",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^8.0.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.5",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.0.1",
    "glob": "^11.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.3",
    "release-it": "^19.2.4",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.59.0",
    "vitest": "^4.0.18"
  },
  "keywords": [
    "deploy",
    "ai-agent",
    "docker",
    "self-hosted",
    "traefik",
    "devops",
    "deployment",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/openlander-ai/openlander.git"
  },
  "license": "AGPL-3.0-only",
  "author": "OpenLander Contributors",
  "homepage": "https://github.com/openlander-ai/openlander",
  "bugs": {
    "url": "https://github.com/openlander-ai/openlander/issues"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "web/src/**/*.{ts,tsx}": [
      "bash -c 'cd web && exec npx eslint --fix \"$@\"' --",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
