{
  "name": "openlander",
  "version": "0.3.6-rc.4",
  "description": "Self-hosted deployment control plane for coding agents",
  "type": "module",
  "bin": {
    "openlander": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "web/dist",
    "drizzle",
    "Dockerfile",
    "Dockerfile.runtime",
    ".dockerignore",
    "Dockerfile.runtime.dockerignore",
    "docker-compose.yml",
    "docker-compose.runtime.yml",
    "install.sh",
    "openlanderctl",
    "scripts/build-runtime-image.sh",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "npm run clean && tsup && npm run build:web",
    "build:web": "cd web && npm ci && npx vite build",
    "docker:build:runtime": "bash scripts/build-runtime-image.sh",
    "docker:up:runtime": "bash scripts/build-runtime-image.sh && OPENLANDER_IMAGE=${OPENLANDER_IMAGE:-openlander:local} docker compose -f docker-compose.runtime.yml up -d",
    "start": "node dist/cli/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:backend:release",
    "test:backend:release": "vitest run --config vitest.release.config.ts",
    "test:migrations": "vitest run --config vitest.release.config.ts test/db/postgres-migration-sanity.test.ts test/db/schema-parity.test.ts",
    "test:api-contract": "vitest run --config vitest.release.config.ts test/contract/system-routes-services.test.ts test/console-contract.test.ts",
    "test:watch": "vitest --config vitest.release.config.ts --watch",
    "test:coverage": "vitest run --config vitest.release.config.ts --coverage",
    "qa:fde-contract": "mkdir -p reports && HUSKY=0 npm ci && vitest run --config vitest.release.config.ts --reporter=default --reporter=junit --outputFile=reports/fde-agent-contract.junit.xml test/e2e-interface-first-agent-contract.test.ts",
    "qa:i18n": "vitest run test/web/korean-localization-quality.test.ts",
    "qa:release": "npm run qa:i18n && npm run lint -- --quiet && npm run typecheck && npm run test:backend:release && npm run build",
    "qa:rc-smoke": "bash scripts/rc-cold-agent-smoke.sh",
    "clean": "rm -rf dist",
    "release": "node -e \"console.error('Use npm run release:rc or npm run release:final. Raw npm run release is disabled to avoid skipping RC validation.'); process.exit(1)\"",
    "release:rc": "release-it --preRelease=rc",
    "release:final": "release-it",
    "prepublishOnly": "npm run build",
    "prepare": "husky",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "docs:validate": "npx tsx scripts/validate-doc-claims.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.94",
    "@ai-sdk/deepseek": "^2.0.45",
    "@ai-sdk/google": "^3.0.89",
    "@ai-sdk/groq": "^3.0.48",
    "@ai-sdk/mcp": "^1.0.59",
    "@ai-sdk/mistral": "^3.0.46",
    "@ai-sdk/openai": "^3.0.81",
    "@ai-sdk/togetherai": "^2.0.62",
    "@ai-sdk/xai": "^3.0.103",
    "@fontsource/noto-sans-kr": "^5.3.0",
    "@hono/node-server": "^1.19.11",
    "@hono/node-ws": "^1.3.1",
    "@inquirer/prompts": "^8.5.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openrouter/ai-sdk-provider": "^2.10.0",
    "ai": "^6.0.220",
    "bcryptjs": "^3.0.3",
    "busboy": "^1.6.0",
    "commander": "^14.0.3",
    "dockerode": "^5.0.1",
    "drizzle-orm": "^0.45.1",
    "duck-duck-scrape": "^2.2.7",
    "hono": "^4.12.28",
    "nanoid": "^5.1.16",
    "nodemailer": "^9.0.3",
    "ollama-ai-provider-v2": "^3.6.0",
    "pdf-fontkit": "^1.8.9",
    "pdf-lib": "^1.17.1",
    "picocolors": "^1.1.1",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "sugar-high": "^0.9.5",
    "ws": "^8.21.0",
    "yaml": "^2.9.0",
    "zhipu-ai-provider": "^0.3.1",
    "zod": "^4.4.3"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    },
    "@protobufjs/utf8": "^1.1.1",
    "express-rate-limit": "^8.5.2",
    "fast-uri": "^3.1.2",
    "glob": {
      "brace-expansion": "^5.0.6"
    },
    "ip-address": "^10.2.0",
    "protobufjs": "^7.6.1",
    "qs": "^6.15.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@playwright/test": "^1.61.1",
    "@release-it/keep-a-changelog": "^7.1.0",
    "@types/busboy": "^1.5.4",
    "@types/dockerode": "^4.0.1",
    "@types/node": "^25.9.5",
    "@types/nodemailer": "^8.0.1",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.0.1",
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.5",
    "release-it": "^20.2.1",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.0.18"
  },
  "keywords": [
    "deploy",
    "ai-agent",
    "docker",
    "self-hosted",
    "traefik",
    "devops",
    "deployment",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/openlander-ai/openlander.git"
  },
  "license": "AGPL-3.0-only",
  "author": "OpenLander Contributors",
  "homepage": "https://github.com/openlander-ai/openlander",
  "bugs": {
    "url": "https://github.com/openlander-ai/openlander/issues"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "web/src/**/*.{ts,tsx}": [
      "bash -c 'cd web && exec npx eslint --fix \"$@\"' --",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
