{
  "name": "openlander",
  "version": "0.1.0",
  "description": "AI agent that deploys your app from a chat",
  "type": "module",
  "bin": {
    "openlander": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "start": "node dist/cli/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@inquirer/prompts": "^7.3.2",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "better-sqlite3": "^11.7.0",
    "commander": "^13.1.0",
    "dockerode": "^4.0.4",
    "hono": "^4.7.4",
    "nanoid": "^5.1.2",
    "picocolors": "^1.1.1",
    "zod": "^4.3.6",
    "zod-to-json-schema": "^3.25.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/dockerode": "^3.3.34",
    "@types/node": "^22.13.4",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.5.2",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1",
    "vitest": "^3.0.6"
  },
  "keywords": [
    "deploy",
    "ai-agent",
    "docker",
    "self-hosted",
    "traefik",
    "devops",
    "deployment",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/openlander/openlander.git"
  },
  "license": "MIT",
  "author": ""
}
