{
  "name": "openlander",
  "version": "1.0.0-rc.7",
  "description": "Self-hosted deployment platform that fixes its own failures",
  "type": "module",
  "bin": {
    "openlander": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "web/dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "npm run clean && tsup && npm run build:web",
    "build:web": "cd web && npm install && npx vite build",
    "start": "node dist/cli/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist",
    "release": "release-it",
    "prepublishOnly": "npm run build",
    "prepare": "husky",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.58",
    "@ai-sdk/google": "^3.0.42",
    "@ai-sdk/mcp": "^1.0.25",
    "@ai-sdk/openai": "^3.0.41",
    "@hono/node-server": "^1.19.11",
    "@hono/node-ws": "^1.3.0",
    "@inquirer/prompts": "^8.3.2",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@openrouter/ai-sdk-provider": "^2.2.3",
    "ai": "^6.0.116",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.8.0",
    "commander": "^14.0.3",
    "dockerode": "^4.0.4",
    "drizzle-orm": "^0.45.1",
    "duck-duck-scrape": "^2.2.7",
    "hono": "^4.12.8",
    "nanoid": "^5.1.7",
    "nodemailer": "^8.0.4",
    "ollama-ai-provider-v2": "^3.3.1",
    "picocolors": "^1.1.1",
    "pino": "^10.3.1",
    "sugar-high": "^0.9.5",
    "ws": "^8.19.0",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@playwright/test": "^1.58.2",
    "@release-it/keep-a-changelog": "^7.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/dockerode": "^3.3.34",
    "@types/node": "^25.5.0",
    "@types/nodemailer": "^7.0.11",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.0",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.1",
    "glob": "^11.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.5.2",
    "release-it": "^19.2.4",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.0.18"
  },
  "keywords": [
    "deploy",
    "ai-agent",
    "docker",
    "self-hosted",
    "traefik",
    "devops",
    "deployment",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/openlander-ai/OpenLander.git"
  },
  "license": "AGPL-3.0-only",
  "author": "OpenLander Contributors",
  "homepage": "https://github.com/openlander-ai/OpenLander",
  "bugs": {
    "url": "https://github.com/openlander-ai/OpenLander/issues"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
